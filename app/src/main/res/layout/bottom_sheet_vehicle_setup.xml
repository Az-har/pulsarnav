<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_elevated"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pill_badge"
        android:backgroundTint="@color/surface_border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.01"
        android:text="Vehicle &amp; Regional Setup"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Calibrate tire pressures, tank capacity and emergency SOS for your exact Bajaj or Rouser model."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Country / Market Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="COUNTRY / REGIONAL MARKET"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerCountry"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_obsidian_input"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_card" />

    <!-- Bike Model Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="MOTORCYCLE MODEL"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerModel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_obsidian_input"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_card" />

    <!-- Preferred Navigation Provider -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="PREFERRED NAVIGATION APP"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavGoogleMaps"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/wine_red_subtle"
            android:text="Google Maps"
            android:textColor="@color/wine_red_light"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/btn_corner_radius_compact"
            app:strokeColor="@color/wine_red_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavWaze"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_card"
            android:text="Waze"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/btn_corner_radius_compact"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Headunit cluster skip toggle -->
    <LinearLayout
        android:id="@+id/rowSkipHeadunitNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skip Cluster Nav when using Headunit"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="For Open Headunit / Android Auto riders: saves BLE bandwidth"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSkipHeadunitNav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Dynamic Tailored Specs Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/surface_border"
        app:strokeWidth="@dimen/card_stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvPreviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pulsar NS200 Specs Preview"
                android:textColor="@color/wine_red_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviewEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="199.5cc Triple Spark 4V Liquid-Cooled"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/surface_border_subtle" />

            <!-- Tire pressures preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COLD FRONT TIRE"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewFrontTire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28 PSI (Solo &amp; Pillion)"
                        android:textColor="@color/mint_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COLD REAR TIRE"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewRearTire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32 PSI Solo / 36 Pillion"
                        android:textColor="@color/mint_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/surface_border_subtle" />

            <!-- Tank & SOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TANK CAPACITY"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewTank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.0 L (Reserve: 2.4 L)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCAL SOS HELPLINE"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewSos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="112 (Universal Emergency)"
                        android:textColor="@color/amber_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Save & Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveVehicleSetup"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height_primary"
        android:backgroundTint="@color/wine_red"
        android:text="Save &amp; Apply Setup"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/btn_corner_radius" />

</LinearLayout>
